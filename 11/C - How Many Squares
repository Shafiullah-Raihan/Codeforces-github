#include <iostream>
#include <vector>
#include <string>
#include <array>
 
using namespace std;
 
const array<int, 8> DX = { 0, 1, 0, -1, 1, 1, -1, -1 };
const array<int, 8> DY = { 1, 0, -1, 0, 1, -1, 1, -1 };
 
void dfs(vector<string>& grid, int x, int y, int& size) {
  if (x < 0 || x >= grid.size() || y < 0 || y >= grid[0].size() || grid[x][y] != '1') {
    return;
  }
 
  grid[x][y] = '2';
  size++;
 
  for (int i = 0; i < 8; ++i) {
    dfs(grid, x + DX[i], y + DY[i], size);
  }
}
 
bool checkLine(const vector<string>& grid, int x, int y, int distance, int startDir, int endDir) {
  for (int i = 0; i <= distance; ++i) {
    for (int dir = startDir; dir < endDir; ++dir) {
      int nx = x + DX[dir] * i;
      int ny = y + DY[dir] * i;
 
      if (nx < 0 || nx >= grid.size() || ny < 0 || ny >= grid[0].size() || grid[nx][ny] != '2') {
        return false;
      }
    }
  }
  return true;
}
 
int main() {
  ios_base::sync_with_stdio(false);
  cin.tie(nullptr);
 
  int t;
  cin >> t;
 
  while (t--) {
    int n, m;
    cin >> n >> m;
 
    vector<string> grid(n);
    for (int i = 0; i < n; ++i) {
      cin >> grid[i];
    }
 
    int totalSquares = 0;
 
    for (int i = 0; i < n; ++i) {
      for (int j = 0; j < m; ++j) {
        if (grid[i][j] == '1') {
          int componentSize = 0;
          dfs(grid, i, j, componentSize);
 
          // Проверка, может ли компонента быть квадратом
          if (componentSize % 4 != 0 || componentSize / 4 > 250) {
            continue;
          }
 
          int side = componentSize / 4;
 
          // Проверка горизонтального квадрата
          bool isHorizontalSquare = checkLine(grid, i, j, side, 0, 2) &&
            checkLine(grid, i + side, j + side, side, 2, 4);
 
          // Проверка вертикального квадрата
          bool isVerticalSquare = checkLine(grid, i, j, side, 4, 6) &&
            checkLine(grid, i + side * 2, j, side, 6, 8);
 
          if (isHorizontalSquare || isVerticalSquare) {
            totalSquares++;
          }
        }
      }
    }
 
    cout << totalSquares << "
";
  }
 
  return 0;
}